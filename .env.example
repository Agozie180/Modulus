# API key needs the Market, Trading, Transaction, Wallet and B402 domains enabled.
# The API refuses some server locations (US, CA, NL, GB, ... see 'Service-Restricted Countries').
BINANCE_WEB3_BASE_URL=https://web3.binance.com/build
BINANCE_WEB3_RECV_WINDOW=10000
BINANCE_WEB3_API_KEY=
BINANCE_WEB3_API_SECRET=
MODULUS_WALLET_ADDRESS=
# only for MODULUS_EXECUTOR=api (direct RFQ signing). baw mode needs no key here.
MODULUS_PRIVATE_KEY=
MODULUS_EXECUTOR=dryrun
MODULUS_MAX_TRADE_USD=5
MODULUS_MAX_DAILY_USD=20
EVM_RPC_URL=https://bsc-dataseed.bnbchain.org
# x402 seller (payTo is set once in B402 onboarding)
MODULUS_B402_PAYTO=
MODULUS_PUBLIC_URL=
# shared secret between Agent Studio (modulusWork.ts) and the core endpoint
MODULUS_CORE_TOKEN=
MODULUS_LIMIT_OFFSET_PCT=0.25
MODULUS_MIN_GAS_BNB=0.002
